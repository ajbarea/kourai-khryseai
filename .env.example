# ──────────────── LLM API Keys ────────────────
# Primary provider (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxx...

# Google AI Studio (Gemini)
# LiteLLM uses GEMINI_API_KEY with the 'gemini/' prefix
GOOGLE_API_KEY=AIza...
GEMINI_API_KEY=AIza...

# OpenAI (Optional)
OPENAI_API_KEY=sk-proj-...

# Local Models (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/api

# ──────────────── Agent Configuration ────────────────
# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
KOURAI_LOG_LEVEL=INFO

# Model Tier: cheap (Haiku 4.5), standard (Sonnet 4.6), smart (Opus 4.6)
KOURAI_MODEL_TIER=cheap

# Max iterations for agent loops (e.g., style auto-fix)
KOURAI_MAX_ITERATIONS=3

# UI Capabilities
KOURAI_STREAM_ENABLED=true

# Force local-only mode (Ollama) bypassing cloud models
KOURAI_USE_LOCAL_MODELS=false

# ──────────────── Infrastructure & Tracing ────────────────
# OpenTelemetry (Jaeger) endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Environment: development, staging, production
ENVIRONMENT=development

# Application metadata
SERVICE_VERSION=0.1.0
