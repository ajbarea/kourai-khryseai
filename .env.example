# Kourai Khryseai — Environment Configuration
#
# Copy to .env, set your provider + API key, run: docker compose up
# Full reference: https://ajbarea.github.io/kourai-khryseai/configuration/

# ── LLM Provider (required) ──────────────────────────────────────────────────

KOURAI_PROVIDER=anthropic          # anthropic | google | local
KOURAI_MODEL_TIER=cheap            # cheap | standard | smart

# ── API Keys (set the one matching your provider) ────────────────────────────

# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ── Optional integrations ────────────────────────────────────────────────────

# GITHUB_PERSONAL_ACCESS_TOKEN=
# BRAVE_API_KEY=
# HF_TOKEN=
# DATABASE_URL=
# DOCKER_HUB_USERNAME=
