# Kourai Khryseai — Environment Configuration
#
# QUICK START:
#   1. Copy this file to .env
#   2. Set KOURAI_PROVIDER and add ONE LLM provider's API key
#   3. (Optional) Add MCP server keys for advanced features
#   4. Start the system: docker compose up
#
# Format: Uncomment lines and replace placeholder values (xxx..., YOUR_*)

# ═══════════════════════════════════════════════════════════════════════════════
# 🔧 CORE SETTINGS — LLM Provider (REQUIRED)
# ═══════════════════════════════════════════════════════════════════════════════

# Primary LLM provider: anthropic | google | local
# Each has different model tiers (cheap/standard/smart)
KOURAI_PROVIDER=anthropic

# Model tier:
#   cheap:    Haiku 4.5       | Gemini 2.0 Flash  | llama3.3:8b      (~$0.001/1K tokens)
#   standard: Sonnet 4.6      | Gemini 2.5 Pro    | llama3.3:70b     (~$0.01/1K tokens)
#   smart:    Opus 4.6        | Gemini 2.5 Pro    | llama3.3:70b     (~$0.1/1K tokens)
KOURAI_MODEL_TIER=cheap

# Log level: DEBUG (verbose), INFO (normal), WARNING, ERROR, CRITICAL
KOURAI_LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════════
# 🔑 LLM API Keys — Choose Your Provider
# ═══════════════════════════════════════════════════════════════════════════════

# Anthropic (Claude) — Recommended for KOURAI_PROVIDER=anthropic
# Get key: https://console.anthropic.com/account/api-keys
# ANTHROPIC_API_KEY=sk-ant-xxx...

# Google Gemini — Use for KOURAI_PROVIDER=google
# Get key: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIza...
# GEMINI_API_KEY=AIza...

# OpenAI (Optional fallback)
# Get key: https://platform.openai.com/account/api-keys
# OPENAI_API_KEY=sk-proj-...

# Ollama (Local/Free) — Use for KOURAI_PROVIDER=local
# Setup: https://ollama.com/ (install and run: ollama serve)
# Runs on localhost:11434 by default
# OLLAMA_BASE_URL=http://localhost:11434/api

# ═══════════════════════════════════════════════════════════════════════════════
# ⚙️  AGENT BEHAVIOR TUNING
# ═══════════════════════════════════════════════════════════════════════════════

# Max iterations for agent loops (e.g., Kallos style auto-fix retries)
KOURAI_MAX_ITERATIONS=5

# Enable real-time streaming in CLI and UI (SSE over WebSocket)
KOURAI_STREAM_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
# 🌐 MCP SERVERS — Advanced Features (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# GitHub — Mneme (PR generation) + Techne (code search)
# Create token: https://github.com/settings/tokens (new)
#               or https://github.com/settings/personal-access-tokens/new
# Scopes needed: repo, read:org, gist
# GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_xxxx...

# Brave Search — Aletheia (research validation)
# Sign up: https://brave.com/search/api/
# Get key: https://api.search.brave.com/res/v1/app/keys
# Used to verify technical claims against live web results
# BRAVE_API_KEY=YOUR_BRAVE_API_KEY

# Context7 — Documentation lookup (LLM-powered docs search)
# Website: https://context7.io/
# Note: Optional. Falls back to Context Hub CLI (chub) if unavailable
# CONTEXT7_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# 🗄️  PLAYER PROJECT DATABASE (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection string for the player's project database.
# Used by Techne and Dokimasia for database schema introspection.
# Gracefully skipped if not set — only needed for database-backed player projects.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mydb

# ═══════════════════════════════════════════════════════════════════════════════
# 📊 INFRASTRUCTURE & OBSERVABILITY (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# OpenTelemetry / Jaeger — Distributed tracing
# Jaeger UI typically runs on http://localhost:16686
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ═══════════════════════════════════════════════════════════════════════════════
# 📦  ARTIFACTS & HF STORAGE BUCKETS (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# HuggingFace write-scope token for agent artifact sync and automated backups.
# Agents call ArtifactStorage.push()/pull() to sync with HF Storage Buckets.
# Backup scripts (backup_player_data.sh, restore_player_data.sh) also use this.
# Without this, artifacts save to local Docker volumes only.
# SETUP:
#   1. Go to: https://huggingface.co/settings/tokens
#   2. Click "New token" — Type: write, Name: kourai-artifacts
#   3. Paste the token below and run: make setup
# HF_TOKEN=hf_xxx...

# HF Storage Bucket ID for agent artifacts (namespace/bucket-name).
# Agents sync to hf://buckets/<KOURAI_BUCKET_ID>/<agent_name>/
# Created automatically by: make setup  (when HF_TOKEN is set)
# KOURAI_BUCKET_ID=ajbar/kourai-artifacts

# HuggingFace username for backup ownership (auto-detected from HF_TOKEN if unset)
# BACKUP_USER=YOUR_HF_USERNAME_HERE

# HF bucket name for player data backups
# BACKUP_BUCKET_NAME=kourai-backups

# Days to retain old backups before automatic cleanup
# BACKUP_RETENTION_DAYS=30

# Deployment environment: development | staging | production
ENVIRONMENT=development

# Service version (used in logs + telemetry)
SERVICE_VERSION=0.1.0

# ═══════════════════════════════════════════════════════════════════════════════
# 🐳 DOCKER REGISTRY — Docker Hub Push Configuration (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Docker Hub username for pushing built images and build cache.
# Leave blank to disable Docker Hub push/cache features.
# Setup:
#   1. Create a Docker Hub account: https://hub.docker.com
#   2. Create a PAT: https://hub.docker.com/settings/security → New Access Token
#   3. Log in locally: docker login
#   4. Set DOCKER_HUB_USERNAME to your username
# DOCKER_HUB_USERNAME=ajb6289
