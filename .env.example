# Kourai Khryseai — Environment Configuration
#
# Copy to .env, set your provider + API key, run: docker compose up
# Full reference: https://ajbarea.github.io/kourai-khryseai/configuration/

# ── LLM Provider (required) ──────────────────────────────────────────────────

KOURAI_PROVIDER=anthropic          # anthropic | google | local
KOURAI_MODEL_TIER=cheap            # cheap | standard | smart

# ── API Keys (set the one matching your provider) ────────────────────────────

# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ── Optional integrations ────────────────────────────────────────────────────

# GITHUB_PERSONAL_ACCESS_TOKEN=
# BRAVE_API_KEY=
# HF_TOKEN=                       # HuggingFace token for artifact sync and model downloads
# DATABASE_URL=
# DOCKER_HUB_USERNAME=
#
# Aletheia citation verifier:
# S2_API_KEY=                      # Semantic Scholar (optional: works keyless but throttled; key by form request)
# OPENALEX_API_KEY=                # OpenAlex (REQUIRED as of 2026, keyless retired; free key at openalex.org/settings/api)

# ── Backup settings ─────────────────────────────────────────────────────────

# BACKUP_USER=                     # HuggingFace username for backup bucket
# BACKUP_BUCKET_NAME=              # HF bucket name for backups
# BACKUP_RETENTION_DAYS=30         # Days to keep old backups before pruning
