# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: multi-provider via LiteLLM
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# OLLAMA_BASE_URL=http://localhost:11434

# Agent Configuration
KOURAI_LOG_LEVEL=INFO
KOURAI_MAX_ITERATIONS=3
KOURAI_STREAM_ENABLED=true
KOURAI_USE_LOCAL_MODELS=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ENVIRONMENT=development
SERVICE_VERSION=0.1.0
